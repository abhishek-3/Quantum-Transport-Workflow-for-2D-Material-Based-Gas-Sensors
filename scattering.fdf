# ============================================================
#  SIESTA 4.1-b4 / TranSIESTA — Scattering Region Calculation
#  Purpose : NEGF transport calculation of the device region.
#            Reads electrode.TSHS from the electrode run.
#
#  INSTRUCTIONS FOR USERS
#  ----------------------
#  1. Copy electrode.TSHS into this directory first.
#  2. Replace LatticeVectors with your scattering cell vectors.
#     The transport-direction length must be an integer multiple
#     of the electrode cell length.
#  3. Replace AtomicCoordinatesAndAtomicSpecies with your
#     scattering region coordinates (electrode + device + electrode).
#  4. Update NumberOfAtoms, used-atoms, and GeometryConstraints
#     to reflect the actual atom count and electrode buffer size.
#  5. Set TS.Voltage to the desired bias (start at 0.0 eV).
#  6. Run: mpirun -np <N> transiesta scattering.fdf > scattering.out
#
#  BIAS CHAINING WORKFLOW
#  ----------------------
#  V = 0.0 eV : set TS.DMUpdate.Init true,  TS.DE.Read false
#  V = 0.1 eV : set TS.DMUpdate.Init false, TS.DE.Read true
#               copy .DM and .TSDE from previous bias directory
#  V = 0.2 eV : repeat with files from 0.1 eV directory
#  ... and so on for each bias point.
#
#  OUTPUT FILES NEEDED FOR TBtrans
#  --------------------------------
#  scattering.TSHS   →  stays in this directory
#  scattering.TSDE   →  stays in this directory
#  electrode.TSHS    →  must remain accessible
# ============================================================

SystemName          Scattering_Region
SystemLabel         scattering         # all output files use this prefix

# ============================================================
# SPECIES AND BASIS
# Must be identical to electrode.fdf
# ============================================================

NumberOfSpecies     3                  # <-- EDIT: match your system
NumberOfAtoms       360                # <-- EDIT: total atoms in scattering cell

%block ChemicalSpeciesLabel
# Index  AtomicNumber  Label
  1      42            Mo              # <-- EDIT: replace with your species
  2       6            C
  3       8            O
%endblock ChemicalSpeciesLabel

PAO.BasisSize       SZP               # must match electrode.fdf exactly
PAO.EnergyShift     0.05 Ry
PAO.SplitNorm       0.25

# ============================================================
# DFT SETTINGS — must match electrode.fdf
# ============================================================

XC.functional       GGA
XC.authors          PBE

MeshCutoff          400.0 Ry

# ============================================================
# SCF CONVERGENCE
# ============================================================

MaxSCFIterations      500
SCF.Mixer.Method      Pulay
SCF.Mixer.History     8
SCF.Mixer.Weight      0.10
SCF.DM.Tolerance      1.0e-4

ElectronicTemperature  25 meV

# ============================================================
# SPIN
# Uncomment if your system is magnetic.
# ============================================================

# SpinPolarized         true
# DM.InitSpinAF         true

# ============================================================
# k-GRID
# Transport direction (A): reduced vs electrode (supercell)
# Lateral direction (B)  : same as electrode
# Vacuum direction (C)   : always 1
# ============================================================

%block kgrid_Monkhorst_Pack
   3   0   0   0.0    # <-- EDIT: transport direction — reduced for supercell
   0   9   0   0.0    # <-- EDIT: lateral direction
   0   0   1   0.0    # vacuum direction — always 1
%endblock kgrid_Monkhorst_Pack

# ============================================================
# TranSIESTA — SOLUTION METHOD
# ============================================================

SolutionMethod      transiesta

# ============================================================
# ELECTRODE DEFINITIONS
# Manual p.139: required keys per electrode block:
#   HS, semi-inf-dir, electrode-position, used-atoms, Bulk
#   chem-pot is required only when TS.Voltage != 0
#
# semi-inf-dir options: -A, +A, -B, +B, -C, +C
# electrode-position  : begin <idx> or end <idx>
# used-atoms          : number of atoms from electrode.TSHS
#                       used as one principal layer
#
# EDIT: update semi-inf-dir to match your transport direction,
#       update used-atoms to match your electrode atom count,
#       update electrode-position indices.
# ============================================================

%block TS.Elecs
  Left
  Right
%endblock TS.Elecs

%block TS.Elec.Left
  HS                  electrode.TSHS   # <-- EDIT: electrode filename
  semi-inf-dir        -A               # <-- EDIT: transport direction
  electrode-position  begin 1          # <-- EDIT: first atom index of left electrode
  used-atoms          120              # <-- EDIT: atoms in one electrode principal layer
  Bulk                true
%endblock TS.Elec.Left

%block TS.Elec.Right
  HS                  electrode.TSHS   # <-- EDIT: electrode filename
  semi-inf-dir        +A               # <-- EDIT: transport direction (opposite sign)
  electrode-position  end -1           # <-- EDIT: last atom index of right electrode
  used-atoms          120              # <-- EDIT: must equal Left used-atoms
  Bulk                true
%endblock TS.Elec.Right

# ============================================================
# CHEMICAL POTENTIALS
# Required only when TS.Voltage != 0.
# At zero bias: comment out ChemPots blocks AND remove
#               chem-pot lines from electrode blocks above.
# At finite bias: uncomment all blocks below and add
#                 chem-pot Left/Right to electrode blocks.
# ============================================================

# %block TS.ChemPots
#   Left
#   Right
# %endblock TS.ChemPots
#
# %block TS.ChemPot.Left
#   mu    V/2
# %endblock TS.ChemPot.Left
#
# %block TS.ChemPot.Right
#   mu   -V/2
# %endblock TS.ChemPot.Right

# ============================================================
# CONTOURS (required at finite bias)
# ============================================================

# TS.Contours.Eq.Pole   2.5 eV
#
# %block TS.Contour.C-Left
#   part circle
#   from -40. eV + V/2 to -10 kT + V/2
#     points 25
#     method g-legendre
# %endblock TS.Contour.C-Left
#
# %block TS.Contour.T-Left
#   part tail
#   from prev to inf
#     points 10
#     method g-fermi
# %endblock TS.Contour.T-Left
#
# %block TS.Contour.C-Right
#   part circle
#   from -40. eV - V/2 to -10 kT - V/2
#     points 25
#     method g-legendre
# %endblock TS.Contour.C-Right
#
# %block TS.Contour.T-Right
#   part tail
#   from prev to inf
#     points 10
#     method g-fermi
# %endblock TS.Contour.T-Right
#
# %block TS.Contours.nEq
#   neq-1
# %endblock TS.Contours.nEq
#
# %block TS.Contour.nEq.neq-1
#   part line
#   from -|V|/2 - 5 kT to |V|/2 + 5 kT
#     delta 0.01 eV
#     method mid-rule
# %endblock TS.Contour.nEq.neq-1

# ============================================================
# BIAS VOLTAGE
# Start at 0.0 eV. Increment in steps of 0.1-0.2 eV.
# Copy .DM and .TSDE from previous bias directory before
# each new bias run.
# ============================================================

TS.Voltage            0.0 eV         # <-- EDIT: bias for this run

# ============================================================
# BIAS CHAINING FLAGS
# At V=0.0 eV (first run):
#   TS.DMUpdate.Init  true
#   DM.UseSaveDM      false
#   TS.DE.Read        false
#   TS.DE.Save        true
#
# At V>0.0 eV (subsequent runs):
#   TS.DMUpdate.Init  false
#   DM.UseSaveDM      true
#   TS.DE.Read        true
#   TS.DE.Save        true
# ============================================================

TS.DMUpdate.Init      true            # <-- EDIT: true only for V=0 run
DM.UseSaveDM          false           # <-- EDIT: false for V=0, true for V>0
TS.DE.Read            false           # <-- EDIT: false for V=0, true for V>0
TS.DE.Save            true            # always true — saves .TSDE for next step

# ============================================================
# GEOMETRY CONSTRAINTS
# Fix electrode buffer atoms so they do not move during
# any geometry relaxation step.
# Comment out entirely if running single-point SCF only
# (which is the standard for TranSIESTA).
#
# EDIT: update atom ranges to match your electrode buffer size.
# Left electrode buffer : atoms 1 to <used-atoms>
# Right electrode buffer: atoms <N - used-atoms + 1> to <N>
# ============================================================

# %block GeometryConstraints
#   position from 1 to 120           # <-- EDIT: left electrode buffer
#   position from 241 to 360         # <-- EDIT: right electrode buffer
# %endblock GeometryConstraints

# ============================================================
# OUTPUT
# ============================================================

SaveHS                      true
SaveRho                     false
SaveElectrostaticPotential  false
TS.SaveHS                   true
WriteCoordsStep             false
WriteMDXmol                 false
COOP.Write                  false

# ============================================================
# LATTICE VECTORS
# Transport direction length = N x electrode transport length
# where N is the number of electrode repetitions in the cell.
# ============================================================

LatticeConstant     1.0 Ang

%block LatticeVectors
# a1_x   a1_y   a1_z
# a2_x   a2_y   a2_z
# a3_x   a3_y   a3_z
  34.4722595220000017    0.0000000000000000    0.0000000000000000
   0.0000000000000000   14.9269280430000002    0.0000000000000000
   0.0000000000000000    0.0000000000000000   31.0964279179999998
%endblock LatticeVectors

# ============================================================
# ATOMIC COORDINATES
# Order MUST be: left electrode | device region | right electrode
# Left and right electrode atom ordering must match electrode.fdf
# exactly (same species order, same fractional positions).
# Right electrode atoms = left electrode atoms + X offset.
# ============================================================

AtomicCoordinatesFormat   Ang

%block AtomicCoordinatesAndAtomicSpecies
# x               y               z               species
# <-- PASTE YOUR SCATTERING REGION COORDINATES HERE -->
# Structure:
#   Atoms   1 to <used-atoms>              : left electrode buffer
#   Atoms   <used-atoms+1> to <N-used>     : device region
#   Atoms   <N-used+1> to <N>              : right electrode buffer
%endblock AtomicCoordinatesAndAtomicSpecies
